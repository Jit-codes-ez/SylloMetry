# ==============================================================================
# SylloMetry Backend Environment Variables Example
# Duplicate this file as .env in the /Backend folder and supply your values.
# NEVER commit the real .env file or sensitive keys to Git.
# ==============================================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sbp_your_publishable_anon_key_here

# Backend-only Secret Key (Required for backend-level checks & user management)
# Found in: Supabase Dashboard > Project Settings > API > service_role (secret)
# NEVER expose this key to frontend clients or browsers.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Frontend Application Origin (used for CORS and OAuth redirect callback)
FRONTEND_URL=http://localhost:5173

# Server & Environment Configuration
ENVIRONMENT=development
PORT=8000

